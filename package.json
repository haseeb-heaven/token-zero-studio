{
  "name": "token-zero-studio",
  "version": "1.0.0",
  "description": "Cross-platform GUI launcher for running AI coding agents through token-optimization proxies",
  "main": "dist/main/index.js",
  "author": "TokenZeroStudio",
  "license": "MIT",
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "build:ci": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dev": "node scripts/build.mjs && env -u ELECTRON_RUN_AS_NODE electron ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^33.4.11",
    "esbuild": "^0.24.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  }
}
